@'
FROM composer:2 AS build
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader

FROM php:8.3-fpm-alpine
WORKDIR /var/www/html
RUN apk add --no-cache nginx supervisor libpng-dev libjpeg-turbo-dev freetype-dev oniguruma-dev && docker-php-ext-configure gd --with-freetype --with-jpeg && docker-php-ext-install pdo pdo_pgsql mbstring gd opcache

COPY --from=build /app/vendor /var/www/html/vendor
COPY . /var/www/html

RUN cp .env.prod .env && php artisan key:generate && php artisan config:cache && php artisan route:cache && php artisan view:cache && chown -R www-data:www-data storage bootstrap/cache

COPY docker/supervisord.conf /etc/supervisord.conf
COPY docker/nginx.conf /etc/nginx/http.d/default.conf

EXPOSE 9000
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
'@ | Set-Content backend/Dockerfile.prod -Encoding UTF8